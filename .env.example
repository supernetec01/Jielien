# Existing PostgreSQL service: set the URL securely; do not commit credentials.
# For the prepared cloud workspace, local OS peer authentication needs no password.
DATABASE_URL=postgresql:///jielien?host=%2Fworkspace%2F.postgres%2Fsocket&port=5433&user=agent
PORT=3001
# Set true when the website is served over HTTPS.
COOKIE_SECURE=false

# Initial receiving bank details for manually reconciled VietQR transfers.
# Có thể chỉnh tại Admin → Tài khoản nhận tiền; cấu hình đã lưu trong Admin được ưu tiên.
# Chưa có mã VietQR: để trống, lưu nháp trong Admin và giữ chuyển khoản ở trạng thái tắt.
# Keep all four blank to disable bank transfers; never use banking login credentials.
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# Optional visual demo label; false does not turn sample catalog into real merchandise.
DEMO_MODE=false

# Theo dõi lỗi tùy chọn. Để trống DSN để tắt từng phía; không điền token quản trị Sentry.
# Backend DSN chỉ ở máy chủ. Frontend DSN là cấu hình công khai được gửi tới trình duyệt.
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
# Tên môi trường Sentry, ví dụ development hoặc production; không chứa dữ liệu cá nhân.
SENTRY_ENVIRONMENT=
# SHA commit dùng làm release. Checkout Git tự đọc HEAD; Docker cần điền SHA này.
GIT_COMMIT=

# Tự hủy đơn chuyển khoản chưa trả tiền: mặc định tắt, hạn mặc định 24 giờ.
# Bật sẽ xét cả đơn cũ còn pending; xem trước bằng npm run orders:expire -- --dry-run.
ORDER_EXPIRY_ENABLED=false
BANK_TRANSFER_TTL_HOURS=24
# Thông báo nhân viên qua Telegram: mặc định tắt. Không nhập token vào Admin/code.
STAFF_NOTIFY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# URL HTTPS website để tạo liên kết tới đơn trong Admin (không có token đơn).
PUBLIC_BASE_URL=
